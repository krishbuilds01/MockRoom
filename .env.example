# Get a free key from Google AI Studio: https://aistudio.google.com/apikey
# Free tier is fine. This key is server side only, never exposed to the browser.
# Local dev: copy this file to .env.local and fill it in.
# Production: set it in Vercel project Settings - Environment Variables.
GEMINI_API_KEY=

# Optional: dedicated key for Gemini TTS in /api/tts. Falls back to GEMINI_API_KEY when unset.
GEMINI_TTS_KEY=

# Optional: override the Gemini Live model name if Google renames it
# GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025

# Optional: sign in with GitHub (Auth.js). Login is optional, the app works without it.
# Create an OAuth app at https://github.com/settings/developers
# Callback URL: https://beta-mockroom.vercel.app/api/auth/callback/github
# For local dev also add http://localhost:3000/api/auth/callback/github on a second app.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Any long random string, used to sign the session token
AUTH_SECRET=

# Optional: Supabase Postgres for syncing session history of signed in users.
# Server side only, the service role key never reaches the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
